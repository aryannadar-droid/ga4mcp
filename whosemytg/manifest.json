{
  "manifest_version": 3,
  "name": "WhoseMyTG",
  "version": "0.5.0",
  "description": "Read a brand's website and find its target groups (TGs): ranked by buy-intent, with reasons to buy, ad angles and landing-page heroes.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.mistral.ai/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "WhoseMyTG"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
